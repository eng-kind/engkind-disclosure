# Streamlit 앱 설정 → Secrets 에 붙여넣는 양식입니다. 실제 키가 든 파일은 GitHub에 올리지 마세요.
[github]
token = "github_pat_..."              # engkind 계정의 fine-grained 토큰 (Contents 읽기/쓰기)
owner = "krx-engkind"                 # engkind@krx.co.kr로 만든 GitHub 사용자명
repo = "engkind-disclosure"
branch = "data"                       # 30분 자동 확인이 저장하는 브랜치
path = "data/disclosure_state.json"

[openai]
api_key = "sk-..."                    # 선택: 엑셀 업로드분 링크 검색용
model = "gpt-4.1-mini"
